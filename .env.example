# Threat Intel Portal Configuration
# Copy to .env and update values

# JWT signing key — CHANGE THIS
JWT_SECRET=change-me-use-a-random-64-char-string

# Feed ingestion interval (hours) — default 4h gives 2+ refreshes per workday
INGEST_INTERVAL_HOURS=4

# JWT token expiry (hours)
TOKEN_EXPIRY_HOURS=72

# CORS origins (comma-separated)
CORS_ORIGINS=https://intel.echobase.tech,http://localhost:3000

# Logging level
LOG_LEVEL=INFO
